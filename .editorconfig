root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.java]
indent_size = 4

[*.{xml,yml,yaml,css,properties,config}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{gitignore,gitattributes,java-version}]
indent_size = 2

[*.cmd]
end_of_line = crlf

[mvnw]
end_of_line = lf

[*.{ico,png,jpg,jpeg,gif}]
insert_final_newline = false
trim_trailing_whitespace = false
